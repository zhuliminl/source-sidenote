{
  "name": "source-sidenote",
  "version": "0.1.0",
  "description": "Local-first AI code reading service with persistent per-file explanations and editor adapters",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "bin": {
    "sidenote": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "public",
    "editors",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/main.js start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "format": "prettier --write src public tests docs *.md *.json .github/workflows/*.yml",
    "format:check": "prettier --check src public tests docs *.md *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
